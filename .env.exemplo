# Copie para .env e preencha — NUNCA suba o .env para o GitHub

ANTHROPIC_API_KEY=sk-ant-...
# Admin API (sk-ant-admin…) — gasto real do mês no Datadog. Console → Settings → Admin keys.
# Sem esta chave o gauge usa o último snapshot do painel, não o teto de US$ 8.99.
# ANTHROPIC_ADMIN_API_KEY=sk-ant-admin...
# Toggle mestre Claude: 0=pausa (padrão operacional, sem gastar USD) | 1=ligado
# Religar/pausar: CLAUDE_ATIVO=1|0 ou python scripts/toggle_claude.py on|off
# Actions: Variable CLAUDE_ATIVO (default nos workflows = 1). Use 0 para pausar gasto.
CLAUDE_ATIVO=1
# Modelos (Haiku barato no volume). Escalonamento ML → Sonnet nos pontos de venda:
CLAUDE_MODELO=claude-haiku-4-5
CLAUDE_MODELO_RAPIDO=claude-haiku-4-5
CLAUDE_MODELO_VENDAS=claude-sonnet-4-5
CLAUDE_ECONOMICO=1
# 1 = sobe para CLAUDE_MODELO_VENDAS em oferta/chat quente no ML (mesmo com ECONOMICO=1)
CLAUDE_ESCALONAR_ML=1
CLAUDE_ESCALONAR_OFERTA=1
# 1 = Sonnet na oferta só com calor alto ou Ads alerta/crítico (não sempre)
CLAUDE_ESCALONAR_OFERTA_SO_CALOR=1
CLAUDE_ESCALONAR_CHAT=1
# Só escala se restante do orçamento local >= este valor (US$)
CLAUDE_ESCALONAR_RESTANTE_MIN_USD=1.50
# Chat ML escala também se preço do anúncio >= este (R$) — kits ~40+
CLAUDE_ESCALONAR_PRECO_MIN=40
# 1 = não dispara WA/TG/FB/IG se link ainda for MLB_PREENCHER (avisa no Telegram)
CONVERSAO_BLOQUEAR_LINK_INVALIDO=1
# Master escrita pública manicures (0 até checklist OK — Claude só analisa + alerta gestor)
CONVERSAO_MANICURES_ESCRITA=0
# 0 = chat ML só no agentes.ml (evita resposta duplicada conversão/auto_respostas)
CONVERSAO_MANICURES_CHAT_ML=0
AUTO_RESPOSTAS_ML=0
# Necessidade manicures × ML: match sinais → SIM gestor → WA/TG
NECESSIDADE_MANICURES_ATIVO=1
NECESSIDADE_MANICURES_ALERTA=1
NECESSIDADE_MANICURES_PEDIR_CONFIRMACAO=1
NECESSIDADE_MANICURES_ENVIAR_CANAIS=1
NECESSIDADE_MANICURES_COOLDOWN_SEG=21600
# Análise de calor (0–100). Score >= ALTO → aumenta IA (Sonnet)
CLAUDE_ANALISE_SCORE_ALTO=70
CLAUDE_ANALISE_SCORE_MEDIO=40
# IG/FB (captação) exige score maior; fechamento ML é o termômetro principal
CLAUDE_ANALISE_SCORE_ALTO_CAPTACAO=85
CLAUDE_ANALISE_GASTO_META_PRESSAO=30
# 1 = se análise alta, fura template de frete/atacado e usa Sonnet
CLAUDE_ANALISE_FURA_TEMPLATE=1
# Orçamento local (US$) — hard stop se a Cost API / snapshot não estiver disponível
CLAUDE_ORCAMENTO_USD=8.99
CLAUDE_ORCAMENTO_ATIVO=1
CLAUDE_ORCAMENTO_ALERTA=1
CLAUDE_ORCAMENTO_ALERTA_TODAS=1
# Nesta fase: desligar IAs "nice to have"
# LEILAO_IA_AVALIAR_PARAMETROS=0
# ALIBABA_IA_AVALIAR_PARAMETROS=0
# REMOVEDORES_UNHA_IA_AVALIAR=0

LOJAHUB_TOKEN=...
LOJAHUB_ANALYTICS_TOKEN=...


BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_ACCESS_TOKEN=
BLING_REFRESH_TOKEN=
BLING_REDIRECT_URI=https://google.com

ML_CLIENT_ID=...
ML_CLIENT_SECRET=...
ML_ACCESS_TOKEN=...
ML_REFRESH_TOKEN=...
ML_SELLER_ID=...
ML_REDIRECT_URI=https://www.google.com
# 1 = ignora bolsas/legado na listagem; reputação da conta continua valendo
ML_IGNORAR_ANUNCIOS_FORA_FOCO=1

# Brave Search API — fallback de busca por termo no ML (quando /sites/search retorna 403)
# Crie em https://brave.com/search/api/ (plano gratuito ~2000 consultas/mês)
BRAVE_SEARCH_API_KEY=
# Cota mensal Brave (free ~2000). 1800 deixa folga. Alerta em 80%. Hard-stop=1 para.
# BRAVE_QUOTA_MES=1800
# BRAVE_QUOTA_ALERTA_PCT=80
# BRAVE_QUOTA_HARD_STOP=1
# Fallbacks busca ML por termo (1=ativo, 0=desliga). Ordem: catálogo → Brave → DDG → cache
ML_BUSCA_TERMO_FALLBACK_BRAVE=1
ML_BUSCA_TERMO_FALLBACK_DDG=1
ML_BUSCA_TERMO_FALLBACK_CATALOGO=1
ML_BUSCA_TERMO_FALLBACK_CACHE=1
ML_BUSCA_TERMO_CACHE_TTL_SEG=21600
ML_BUSCA_TERMO_MAX_REFS_CATALOGO=5

SHOPEE_PARTNER_ID=...
SHOPEE_PARTNER_KEY=...
SHOPEE_SHOP_ID=...
SHOPEE_ACCESS_TOKEN=...
SHOPEE_REFRESH_TOKEN=...

MAGALU_CLIENT_ID=...
MAGALU_CLIENT_SECRET=...
# ID do canal Magazine Luiza na OpenAPI (preferir sobre MAGALU_MERCHANT_ID legado)
MAGALU_CHANNEL_ID=...
MAGALU_MERCHANT_ID=...
MAGALU_REDIRECT_URI=https://www.google.com
MAGALU_ACCESS_TOKEN=...
MAGALU_REFRESH_TOKEN=...

# Busca multi-marketplace para esmaltes/removedores (ML + Magalu + Shopee + Amazon)
MARKETPLACES_BUSCA_ATIVOS=mercadolivre,magalu,shopee,amazon
ESMALTES_BUSCA_MULTI_MARKETPLACE=1

# Monitor tendências esmaltes (web × marketplaces)
ESMALTES_TENDENCIAS_CATALOGO=catalogo/esmaltes_tendencias_internet.json
ESMALTES_TENDENCIAS_PAUSA_SEG=2.0
ESMALTES_TENDENCIAS_ALERTA_RESUMO=1
ESMALTES_TENDENCIAS_ALERTA_COOLDOWN_SEG=43200

AMAZON_LWA_CLIENT_ID=...
AMAZON_LWA_CLIENT_SECRET=...
AMAZON_REDIRECT_URI=https://www.google.com
AMAZON_REFRESH_TOKEN=...
AMAZON_ACCESS_TOKEN=...
AMAZON_SELLER_ID=...
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC

META_ACCESS_TOKEN=...
META_AD_ACCOUNT_ID=...
META_PAGE_ID=...
META_INSTAGRAM_ID=...
# App do Meta for Developers — necessário para gerar/renovar o token longo
META_APP_ID=1620061095945884
META_APP_SECRET=
META_REDIRECT_URI=https://www.google.com
META_API_VERSION=v25.0
# Opcional: persiste o token longo renovado em disco (máquina persistente)
# META_TOKEN_STORE=dados/meta_token.json
META_CPC_MAXIMO=1.50
META_CTR_MINIMO=1.00
META_ROAS_MINIMO=2.00
META_FREQ_MAXIMA=3.00
META_GASTO_MINIMO_ALERTA=50.0
META_ROAS_MINIMO_MANICURES=2.20
META_CTR_MINIMO_MANICURES=1.20

TELEGRAM_TOKEN=...
TELEGRAM_CHAT_ID=...
TELEGRAM_GESTOR_CHAT_ID=...
# Blocos "O que este agente faz" / "Quando roda" nos alertas (1=liga, 0=off)
# Textos em core/telegram_explicacao.py
TELEGRAM_EXPLICACAO_AGENTES=1

# Datadog Log Management (opcional — envia logs INFO+ via HTTP Intake API)
# DD_API_KEY: Organization Settings -> API Keys no painel Datadog
# DD_APPLICATION_KEY: Organization Settings -> Application Keys (consulta Logs API no vigia)
# DD_SITE: região do site (org Robo-Markplaces: us5.datadoghq.com)
# DD_LOGS_ENABLED: false desliga só o envio de logs (custo/volume)
# DD_METRICS_ENABLED: false desliga só métricas customizadas (independente dos logs)
# DD_ENV: ambiente exibido na tag env: no Datadog (production, staging, dev)
DD_API_KEY=
DD_APPLICATION_KEY=
DD_SITE=us5.datadoghq.com
DD_LOGS_ENABLED=true
DD_METRICS_ENABLED=true
DD_ENV=production
# Erros ruidosos no Datadog (0=silenciados como debug). Religar com =1:
# LOG_ERROS_VEICULOS_SCRAPERS — Leopardo / lojas batidos (timeout/conexão)
# Sumaré Leilões — DESLIGADO por padrão (SSL do site). Religar: LEILAO_INCLUIR_SUMARE_DIRETO=1
# LEILAO_INCLUIR_SUMARE_DIRETO=0
# LOG_ERROS_BLING — Bling 401/403 / empresa inativa
# LOG_ERROS_TOKENS — Magalu / Shopee / Amazon (credenciais / refresh)
# LOG_ERROS_PEDIDOS — busca de pedidos FALHOU (margem / notificador)
LOG_ERROS_VEICULOS_SCRAPERS=0
LOG_ERROS_CLAUDE=0
LOG_ERROS_BLING=0
LOG_ERROS_TOKENS=0
LOG_ERROS_PEDIDOS=0
# LOG_ERROS_PNCP — timeouts/503 do PNCP (gov.br); silenciado por padrão
LOG_ERROS_PNCP=0
# LICITACOES_PNCP_TIMEOUT_SEG=30
# LICITACOES_PNCP_FALHAS_PARA_BREAKER=3
# LICITACOES_PNCP_BREAKER_SEG=900

NFE_NATUREZA_OPERACAO=Venda de mercadoria
NFE_CFOP_PADRAO=5102
NFE_CST_PADRAO=00
NFE_CSOSN_PADRAO=102
NFE_ORIGEM_PADRAO=0
NFE_SERIE_PADRAO=1

MARGEM_MINIMA=15.0
# Monitor margem vendas (Telegram) — default = MARGEM_MINIMA
MONITOR_MARGEM_VENDAS_DIAS=2
MONITOR_MARGEM_VENDAS_MARGEM_MIN_PCT=15.0
MONITOR_MARGEM_VENDAS_RESUMO_COOLDOWN_SEG=14400
MONITOR_MARGEM_VENDAS_ALERTA_BAIXA=1
MONITOR_MARGEM_VENDAS_ALERTA_RESUMO=1
# Monitor concorrentes: gap vs preço alvo só com MLB vivo
MONITOR_CONCORRENTES_ALERTAR_GAP_SO_ANUNCIO_VIVO=1
