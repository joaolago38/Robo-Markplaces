# Copie para .env e preencha — NUNCA suba o .env para o GitHub

ANTHROPIC_API_KEY=sk-ant-...

LOJAHUB_TOKEN=...
LOJAHUB_ANALYTICS_TOKEN=...


BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_ACCESS_TOKEN=
BLING_REFRESH_TOKEN=
BLING_REDIRECT_URI=https://google.com

ML_CLIENT_ID=...
ML_CLIENT_SECRET=...
ML_ACCESS_TOKEN=...
ML_REFRESH_TOKEN=...
ML_SELLER_ID=...
ML_REDIRECT_URI=https://www.google.com

# Brave Search API — fallback de busca por termo no ML (quando /sites/search retorna 403)
# Crie em https://brave.com/search/api/ (plano gratuito ~2000 consultas/mês)
BRAVE_SEARCH_API_KEY=
# Fallbacks busca ML por termo (1=ativo, 0=desliga). Ordem: catálogo → Brave → DDG → cache
ML_BUSCA_TERMO_FALLBACK_BRAVE=1
ML_BUSCA_TERMO_FALLBACK_DDG=1
ML_BUSCA_TERMO_FALLBACK_CATALOGO=1
ML_BUSCA_TERMO_FALLBACK_CACHE=1
ML_BUSCA_TERMO_CACHE_TTL_SEG=21600
ML_BUSCA_TERMO_MAX_REFS_CATALOGO=5

SHOPEE_PARTNER_ID=...
SHOPEE_PARTNER_KEY=...
SHOPEE_SHOP_ID=...
SHOPEE_ACCESS_TOKEN=...
SHOPEE_REFRESH_TOKEN=...

MAGALU_CLIENT_ID=...
MAGALU_CLIENT_SECRET=...
# ID do canal Magazine Luiza na OpenAPI (preferir sobre MAGALU_MERCHANT_ID legado)
MAGALU_CHANNEL_ID=...
MAGALU_MERCHANT_ID=...
MAGALU_REDIRECT_URI=https://www.google.com
MAGALU_ACCESS_TOKEN=...
MAGALU_REFRESH_TOKEN=...

# Busca multi-marketplace para esmaltes/removedores (ML + Magalu + Shopee + Amazon)
MARKETPLACES_BUSCA_ATIVOS=mercadolivre,magalu,shopee,amazon
ESMALTES_BUSCA_MULTI_MARKETPLACE=1

# Monitor tendências esmaltes (web × marketplaces)
ESMALTES_TENDENCIAS_CATALOGO=catalogo/esmaltes_tendencias_internet.json
ESMALTES_TENDENCIAS_PAUSA_SEG=2.0
ESMALTES_TENDENCIAS_ALERTA_RESUMO=1
ESMALTES_TENDENCIAS_ALERTA_COOLDOWN_SEG=43200

AMAZON_LWA_CLIENT_ID=...
AMAZON_LWA_CLIENT_SECRET=...
AMAZON_REDIRECT_URI=https://www.google.com
AMAZON_REFRESH_TOKEN=...
AMAZON_ACCESS_TOKEN=...
AMAZON_SELLER_ID=...
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC

META_ACCESS_TOKEN=...
META_AD_ACCOUNT_ID=...
META_PAGE_ID=...
META_INSTAGRAM_ID=...
# App do Meta for Developers — necessário para gerar/renovar o token longo
META_APP_ID=1620061095945884
META_APP_SECRET=
META_REDIRECT_URI=https://www.google.com
META_API_VERSION=v25.0
# Opcional: persiste o token longo renovado em disco (máquina persistente)
# META_TOKEN_STORE=dados/meta_token.json
META_CPC_MAXIMO=1.50
META_CTR_MINIMO=1.00
META_ROAS_MINIMO=2.00
META_FREQ_MAXIMA=3.00
META_GASTO_MINIMO_ALERTA=50.0
META_ROAS_MINIMO_MANICURES=2.20
META_CTR_MINIMO_MANICURES=1.20

TELEGRAM_TOKEN=...
TELEGRAM_CHAT_ID=...
TELEGRAM_GESTOR_CHAT_ID=...

# Datadog Log Management (opcional — envia logs INFO+ via HTTP Intake API)
# DD_API_KEY: Organization Settings -> API Keys no painel Datadog
# DD_APPLICATION_KEY: Organization Settings -> Application Keys (consulta Logs API no vigia)
# DD_SITE: região do site (ex.: datadoghq.com, datadoghq.eu)
# DD_LOGS_ENABLED: false desliga o envio sem remover código (controle de custo/volume)
# DD_ENV: ambiente exibido na tag env: no Datadog (production, staging, dev)
DD_API_KEY=
DD_APPLICATION_KEY=
DD_SITE=datadoghq.com
DD_LOGS_ENABLED=true
DD_ENV=production

NFE_NATUREZA_OPERACAO=Venda de mercadoria
NFE_CFOP_PADRAO=5102
NFE_CST_PADRAO=00
NFE_CSOSN_PADRAO=102
NFE_ORIGEM_PADRAO=0
NFE_SERIE_PADRAO=1

MARGEM_MINIMA=15.0
# Monitor margem vendas (Telegram) — default = MARGEM_MINIMA
MONITOR_MARGEM_VENDAS_DIAS=2
MONITOR_MARGEM_VENDAS_MARGEM_MIN_PCT=15.0
MONITOR_MARGEM_VENDAS_RESUMO_COOLDOWN_SEG=14400
MONITOR_MARGEM_VENDAS_ALERTA_BAIXA=1
MONITOR_MARGEM_VENDAS_ALERTA_RESUMO=1
# Monitor concorrentes: gap vs preço alvo só com MLB vivo
MONITOR_CONCORRENTES_ALERTAR_GAP_SO_ANUNCIO_VIVO=1
# Anúncios sem venda no período
MONITOR_SEM_VENDA_DIAS=30
MONITOR_SEM_VENDA_MAX_ITENS=40
MONITOR_SEM_VENDA_ALERTA_RESUMO=1
MONITOR_SEM_VENDA_COOLDOWN_SEG=14400
MONITOR_SEM_VENDA_VISITAS_ALTAS=20
ESTOQUE_CRITICO=20
CPC_MAXIMO=1.50
ROAS_ESCALA=3.0
MARKETPLACE_VARIACAO_ALERTA_PCT=5.0
LUCRO_MINIMO_REPRICING_PCT=10.0
REPRICING_ABAIXO_CONCORRENTE_PCT=3.0
REPRICING_DIFERENCA_MINIMA=0.50
TAXA_CANAL_PADRAO_PCT=18.0
MARGEM_FASE_1_PCT=10.0
MARGEM_FASE_2_PCT=18.0
MARGEM_FASE_3_PCT=25.0
MARKETPLACE_DRY_RUN_REPRICING=true
MARKETPLACE_ALERTAR_ATENCAO=false
MARKETPLACE_KEEPALIVE_LIMITE_DIAS=5
MARKETPLACE_SCHEDULE_HOUR=6
MARKETPLACE_SLEEP_SECONDS=30

AVALIACOES_PARA_ADS=20
NOTA_MINIMA_PARA_ADS=4.8
AVALIACOES_PARA_ESCALAR=50
ACOS_MAXIMO=0.20
# Máx. anúncios ML analisados por ciclo (monitor/panorama). Mais alto = mais tempo e chamadas API.
ML_MAX_ITENS_ANALISE=30
BUDGET_FASE_INICIO=10.0
BUDGET_FASE_CRESCIMENTO=30.0
BUDGET_FASE_ESCALA=80.0
ML_ADS_KILL_SWITCH=false
# Kill switch global de emergência: true = nenhuma escrita real (NF-e, estoque, repricing, anúncios, ads ML)
ROBO_PAUSAR_ESCRITA=false
ML_ADS_ORCAMENTO_MAXIMO=500.0
ML_ADS_ACOS_DIAS_LIMITE=3

# Header X-API-Key exigido em todas as chamadas à API (exceto /health).
# Deixe vazio só durante desenvolvimento local — em produção, defina
# sempre, ou qualquer pessoa com acesso à URL pode chamar a API.
ROBO_API_KEY=

# WhatsApp — escolha o tipo: "evolution" ou "meta"
WHATSAPP_API_TYPE=evolution

# Evolution API (auto-hospedada — recomendado)
WHATSAPP_API_URL=http://seu-servidor:8080  
WHATSAPP_API_KEY=sua_api_key_evolution
WHATSAPP_INSTANCE=nome_da_instancia

# Número que vai receber as notificações (sem + e sem espaços)
WHATSAPP_NUMERO_DESTINO=5519999889059

# WhatsApp Business Cloud (Meta) — preencher só se WHATSAPP_API_TYPE=meta
WHATSAPP_BUSINESS_TOKEN=...
WHATSAPP_PHONE_ID=...

# Monitor carros batidos — lojas do catálogo + busca web nacional (DDG), alerta Telegram
CARROS_BATIDOS_PRECO_MAX=150000
CARROS_BATIDOS_INCLUIR_FIPE=1
CARROS_BATIDOS_ALERTA_RESUMO=1
# Busca web em todo o Brasil (1=ativa). Roda a cada 4h via workflow carros_batidos.yml
CARROS_BATIDOS_BUSCA_WEB=1
# Quantas UFs varrer por rodada (rotaciona ao longo do dia; total = 15)
CARROS_BATIDOS_BUSCA_WEB_MAX_UFS=9
CARROS_BATIDOS_BUSCA_WEB_RESULTADOS=8
CARROS_BATIDOS_BUSCA_WEB_PAUSA_SEG=3

# AWS (opcional — migração incremental Free Tier; padrão = file, sem AWS)
# STORAGE_BACKEND=file
# DYNAMODB_TABLE_NAME=robo-markplaces-estado-teste
# AWS_REGION=us-east-1
# SSM_PARAMETER_PREFIX=/robo-markplaces/teste
